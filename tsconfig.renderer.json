{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src/sources/renderer/**/*.ts",
    "src/sources/renderer/**/*.tsx",
    "src/sources/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/sources/main.ts",
    "src/sources/preload.ts",
    "src/tests/**/*"
  ]
}
