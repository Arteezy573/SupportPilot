{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "noEmit": false,
    "outDir": "./dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/sources/main.ts",
    "src/sources/preload.ts",
    "src/sources/utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/sources/renderer/**/*",
    "src/tests/**/*"
  ]
}
