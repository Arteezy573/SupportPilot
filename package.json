{
  "name": "support-pilot",
  "version": "1.0.0",
  "description": "Desktop Electron application for support engineers to analyze logs, emails, and create structured livesite tickets using AI assistance",
  "main": "dist/main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "dev:renderer": "webpack --config webpack.renderer.config.js --mode development --watch",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "start": "npm run build && npm run electron",
    "start:dev": "npm run dev & wait-on dist/main.js && npm run electron:dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "fluent-ui",
    "support",
    "chat",
    "ai",
    "livesite",
    "ticket",
    "analysis",
    "desktop"
  ],
  "author": {
    "name": "D365 Retail and Commerce team"
  },
  "contributors": [
    {
      "name": "Guanghua Cheng",
      "email": "guacheng@microsoft.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/company/support-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/company/support-pilot/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "Chrome >= 108"
  ],
  "electronVersion": "latest",
  "dependencies": {
    "@fluentui/react-components": "^9.70.0",
    "electron": "^38.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.4",
    "rimraf": "^6.0.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "url-loader": "^4.1.1",
    "wait-on": "^8.0.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  }
}
