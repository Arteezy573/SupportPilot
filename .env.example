# Azure DevOps Configuration
ADO_ORGANIZATION=your-organization
ADO_PROJECT=your-project
ADO_PAT=your-personal-access-token

# ICM (Incident Command and Management) Configuration
ICM_API_URL=https://icm.your-company.com/api
ICM_API_KEY=your-icm-api-key
ICM_TENANT=your-tenant-id

# Development Mode (set to 'development' for mock data)
NODE_ENV=production